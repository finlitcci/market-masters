{
  "name": "market-masters",
  "version": "1.0.0",
  "description": "Market Masters: a multiplayer classroom investing simulator (simulated money only)",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k \"node --disable-warning=ExperimentalWarning --watch server/index.js\" \"vite\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"server/test/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "docs": "node scripts/generate-docs.mjs",
    "test:e2e": "node --disable-warning=ExperimentalWarning server/test/e2e-browser.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "express": "^5.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}